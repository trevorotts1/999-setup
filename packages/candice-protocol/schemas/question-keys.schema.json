{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.blackceo.dev/candice/question-keys.schema.json",
  "title":"Candice governed-question authority registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","registryVersion","activeKeys","retiredKeys","keys"],
  "properties":{
    "schemaVersion":{"const":"2.0"},
    "registryVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "activeKeys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/key"}},
    "retiredKeys":{"type":"array","items":{"$ref":"#/$defs/retired"}},
    "keys":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/entry"}}
  },
  "$defs":{
    "key":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]*$"},
    "skill":{"enum":["spec-protocol","kaizen","eli5","bro"]},
    "stringList":{"type":["array","null"],"items":{"type":"string","minLength":1},"uniqueItems":true},
    "source":{"type":"object","additionalProperties":false,"required":["path","anchor","digest"],"properties":{"path":{"type":"string","minLength":1},"anchor":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "privacy":{"type":"object","additionalProperties":false,"required":["sensitivity","readAloud","caption","log","personalOptIn"],"properties":{"sensitivity":{"enum":["normal","secret","personal"]},"readAloud":{"type":"boolean"},"caption":{"const":"show"},"log":{"enum":["redact","never"]},"personalOptIn":{"type":"boolean"}},"allOf":[{"if":{"properties":{"sensitivity":{"const":"secret"}}},"then":{"properties":{"readAloud":{"const":false}}}},{"if":{"properties":{"sensitivity":{"const":"personal"}}},"then":{"properties":{"personalOptIn":{"const":true}}}}]},
    "count":{"type":"object","additionalProperties":false,"required":["counted","classification","progressRule"],"properties":{"counted":{"type":"boolean"},"classification":{"enum":["STATIC","RESOLVED_DYNAMIC","CHOICE_DYNAMIC","CONDITION_DYNAMIC"]},"progressRule":{"type":"string","minLength":1}}},
    "condition":{"oneOf":[{"type":"object","additionalProperties":false,"required":["op"],"properties":{"op":{"const":"true"}}},{"type":"object","additionalProperties":false,"required":["op","fact","equals"],"properties":{"op":{"const":"equals"},"fact":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"equals":{"type":["string","boolean","number"]}}},{"type":"object","additionalProperties":false,"required":["op","items"],"properties":{"op":{"enum":["all","any"]},"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/condition"}}}}]},
    "retry":{"type":"object","additionalProperties":false,"required":["maxRetries","dontKnow","default"],"properties":{"maxRetries":{"type":"integer","minimum":0,"maximum":3},"dontKnow":{"enum":["accepted","default","not-applicable"]},"default":{"type":"string","minLength":1}}},
    "resume":{"type":"object","additionalProperties":false,"required":["pendingRecovery","answeredKey"],"properties":{"pendingRecovery":{"const":"same-key-once"},"answeredKey":{"const":"never-reask"}}},
    "retired":{"type":"object","additionalProperties":false,"required":["key","skill","meaning","retiredIn","replacement"],"properties":{"key":{"$ref":"#/$defs/key"},"skill":{"$ref":"#/$defs/skill"},"meaning":{"type":"string","minLength":1},"retiredIn":{"type":"string"},"replacement":{"type":["string","null"]}}},
    "entry":{"type":"object","additionalProperties":false,"required":["key","skill","meaning","source","display","spoken","answerKind","allowedInputModes","options","validation","privacy","count","conditions","retry","resume","helpText","canGoBack"],"properties":{"key":{"$ref":"#/$defs/key"},"skill":{"$ref":"#/$defs/skill"},"order":{"type":"integer","minimum":1},"meaning":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source"},"display":{"type":"string","minLength":1},"spoken":{"type":"string","minLength":1},"answerKind":{"enum":["free_text","single_choice","yes_no","confirm","mode_choice"]},"allowedInputModes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["voice","typed","terminal"]}},"options":{"$ref":"#/$defs/stringList"},"validation":{"type":["object","null"]},"privacy":{"$ref":"#/$defs/privacy"},"count":{"$ref":"#/$defs/count"},"conditions":{"$ref":"#/$defs/condition"},"retry":{"$ref":"#/$defs/retry"},"resume":{"$ref":"#/$defs/resume"},"helpText":{"type":["string","null"]},"canGoBack":{"type":"boolean"}}}
  }
}
