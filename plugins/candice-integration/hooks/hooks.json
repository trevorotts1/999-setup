{
  "description": "Candice wake-up hooks. Fires only for the four supported slash commands. The dispatcher requests a fail-soft visual wake; it does not bind a Claude session or terminal host until an authenticated runtime boundary exists. Every handler is non-blocking and never stops the skill.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "spec-protocol",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wake-candice.mjs", "--command", "/spec-protocol"],
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "kaizen",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wake-candice.mjs", "--command", "/kaizen"],
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "eli5",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wake-candice.mjs", "--command", "/eli5"],
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "bro",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/wake-candice.mjs", "--command", "/bro"],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
