# Never commit credentials, secrets, or generated local state.
API docs.md
.env
.env.*
*.secret
*.secrets
credentials*
secrets*

# Local OS droppings
.DS_Store
Thumbs.db

# Node
node_modules/

# Python build artifacts
__pycache__/
*.pyc

# Local state / logs written during setup runs on any machine
router-session.json
route-state.json
*.log

# Pre-merge backups live on pushed snapshot branches, not as in-tree .bak files
*.bak-*

# Boss governance: the live campaign config (locked waves, wave count,
# entry-gate epoch, caps, sanctioned classes) is box-local — only the neutral
# example is committed.
CONTROL/boss-config.json

# Candice Companion build outputs (never committed; release CI rebuilds).
# Disclosed WS-23 relocation 2026-08-21: covers the app bundle staging dir,
# the Tauri shell outputs, and every nested crate target at any depth
# (src-tauri/**/target/ matches audio/capture, audio/capture-windows, tts,
# stt, signature-helper).
apps/candice-companion/dist/
apps/candice-companion/src-tauri/dist/
apps/candice-companion/src-tauri/target/
apps/candice-companion/src-tauri/**/target/
apps/candice-companion/src-tauri/gen/
# Generated mirror of the app-root tauri.conf.json (build.rs copies it)
apps/candice-companion/src-tauri/tauri.conf.json
# Q-10 release-config-guard crate build outputs (sign/verify helper binary)
scripts/candice-release/release-config-guard/target/

# Candice speech assets (FIX-015 installer lane): the model binaries and the
# relocatable Python interpreter are placed into the source tree at build time
# so `bundle.resources` can pick them up. They are NOT tracked artifacts — the
# durable copies live at
# ~/Library/Application Support/BlackCEO/999/speech-assets-source/.
# SPEECH-INVENTORY.json is source and MUST stay tracked; it is not listed here.
apps/candice-companion/src-tauri/speech-assets/stt/ggml-tiny.en-q5_1.bin
apps/candice-companion/src-tauri/speech-assets/stt/whisper-cli
apps/candice-companion/src-tauri/speech-assets/stt/whisper-cli.exe
apps/candice-companion/src-tauri/speech-assets/stt/whisper-cli-win32/
apps/candice-companion/src-tauri/speech-assets/tts/runtime/kokoro-v1.0.fp16.onnx
apps/candice-companion/src-tauri/speech-assets/tts/runtime/voices-v1.0.bin
apps/candice-companion/src-tauri/speech-assets/tts/python/
apps/candice-companion/src-tauri/speech-assets/tts/runtime/runtime.py
apps/candice-companion/src-tauri/speech-assets/tts/runtime/requirements.txt

# Generated by tests/a11y-matrix/contrast.test.mjs on every run — a stale copy
# invites someone to trust numbers that no longer match the shipped tokens.
tests/a11y-matrix/report/
