# Never commit credentials, secrets, or generated local state.
API docs.md
.env
.env.*
*.secret
*.secrets
credentials*
secrets*

# Local OS droppings
.DS_Store
Thumbs.db

# Node
node_modules/

# Python build artifacts
__pycache__/
*.pyc

# Local state / logs written during setup runs on any machine
router-session.json
route-state.json
*.log
# Vendored canonical evidence logs are SOURCE, not runtime state: the council
# vendor record and its aggregate hash include them (scripts/test-council-vendor.sh).
!/.claude/skills/council-of-wise-elders/evidence/**/*.log

# Pre-merge backups live on pushed snapshot branches, not as in-tree .bak files
*.bak-*

# Boss governance: the live campaign config (locked waves, wave count,
# entry-gate epoch, caps, sanctioned classes) is box-local — only the neutral
# example is committed.
CONTROL/boss-config.json

# Boss liveness marker: rewritten every cycle, telemetry not a work record.
CONTROL/boss-heartbeat
CONTROL/stop-workstream
# Hook Skill runtime state (written by the guard and its tests, never source)
.claude/skills/hook-skill/hooks/workflow-guard/state/

# LPG003: downloaded mediapipe face model (installed by lip_gate/install_face_model.py, never committed)
.claude/skills/drama-song-ad-factory/assets/face_landmarker.task
