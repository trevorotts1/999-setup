# Never commit credentials, secrets, or generated local state.
API docs.md
.env
.env.*
*.secret
*.secrets
credentials*
secrets*

# Local OS droppings
.DS_Store
Thumbs.db

# Node
node_modules/

# Python build artifacts
__pycache__/
*.pyc

# Local state / logs written during setup runs on any machine
router-session.json
route-state.json
*.log

# Pre-merge backups live on pushed snapshot branches, not as in-tree .bak files
*.bak-*

# Boss governance: the live campaign config (locked waves, wave count,
# entry-gate epoch, caps, sanctioned classes) is box-local — only the neutral
# example is committed.
CONTROL/boss-config.json

# Candice Companion build outputs (never committed; release CI rebuilds).
# Disclosed WS-23 relocation 2026-08-21: covers the app bundle staging dir,
# the Tauri shell outputs, and every nested crate target at any depth
# (src-tauri/**/target/ matches audio/capture, audio/capture-windows, tts,
# stt, signature-helper).
apps/candice-companion/dist/
apps/candice-companion/src-tauri/dist/
apps/candice-companion/src-tauri/target/
apps/candice-companion/src-tauri/**/target/
apps/candice-companion/src-tauri/gen/
# Generated mirror of the app-root tauri.conf.json (build.rs copies it)
apps/candice-companion/src-tauri/tauri.conf.json
# Q-10 release-config-guard crate build outputs (sign/verify helper binary)
scripts/candice-release/release-config-guard/target/
