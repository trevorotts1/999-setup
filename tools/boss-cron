def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def enforcement_epoch():
    """The moment the full 8-check boss first ran a live cycle. Written by the
    first live cycle; --check never writes. Waves dispatched BEFORE the epoch
    cannot be retroactively judged by checks that did not exist when they
    dispatched — pre-epoch waves are exempt, post-epoch waves are enforced.
    Returns the epoch datetime (or None when never recorded)."""
    if os.path.exists(BOSS_EPOCH):
        try:
            with open(BOSS_EPOCH, "r", encoding="utf-8") as fh:
                return datetime.datetime.strptime(fh.read().strip(), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
        except (OSError, ValueError):
            return None
    return None


def record_enforcement_epoch():
    if not os.path.exists(BOSS_EPOCH):
        with open(BOSS_EPOCH, "w", encoding="utf-8") as fh:
            fh.write(now_iso())


