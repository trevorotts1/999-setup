def check_wave_lock(lines):
    """PART 4 check 2: any wave in the ledger not in the locked table without
    a NEW-WAVE-N dependency line = violation; plus the locked-dependency rule
    (no wave N+1 dispatch before WAVE N CLOSED)."""
    closed = set()
    new_wave_deps = set()
    dispatched = set()
    for ln in lines:
        if ln.startswith("- `WAVE ") and "CLOSED" in ln:
            m = re.search(r"WAVE (\d+) CLOSED", ln)
            if m:
                closed.add(int(m.group(1)))
        if "NEW-WAVE-N" in ln or re.search(r"NEW-WAVE-\d+", ln):
            for m in re.finditer(r"NEW-WAVE-(\d+)", ln):
                new_wave_deps.add(int(m.group(1)))
        if is_dispatch_line(ln):
            m = re.search(r"WAVE (\d+)", ln)
            if m:
                dispatched.add(int(m.group(1)))
    violations = []
    # Dependency rule: wave N+1 dispatch requires WAVE N CLOSED. Only waves
    # ACTUALLY dispatched are judged — a ledger that never dispatched wave N
    # cannot be charged for it (absence is not evidence; PART 4 negative
    # contract: flag what is present, never what is missing from a range).
    # Wave 1 opens the run from a fresh-start baseline (no prior wave to
    # close) and is exempt by design.
    for w in sorted(dispatched):
        if w == 1:
            continue
        if w - 1 not in closed:
            violations.append(f"wave {w} dispatched but no WAVE {w-1} CLOSED line")
    # Locked-table rule: waves beyond the immutable count need a NEW-WAVE-N line.
    for w in sorted(dispatched):
        if w > LOCKED_WAVE_COUNT and w not in new_wave_deps:
            violations.append(
                f"wave {w} dispatched, not in the locked table (count {LOCKED_WAVE_COUNT}), "
                f"no NEW-WAVE-{w} dependency line")
    return violations


def check_width(lines):
    """PART 4 check 4: the LATEST dispatch line per wave must carry either the
    full scripted width (all locked workflows named + 'Width justification' or
    'full PART 2 scripted width') or a recorded dependency line. Historical
    under-width lines already superseded by a later redispatch are resolved,
    not re-fired. Padding past the work is ALSO a violation — a dispatch that
    pads seats beyond what the work allows never satisfies the width bar."""
    latest = {}
    for ln in lines:
        if not is_dispatch_line(ln):
            continue
        m = re.search(r"WAVE (\d+)", ln)
        if m:
            latest[int(m.group(1))] = ln
    violations = []
    for wave, ln in latest.items():
        wfs = LOCKED_WAVES.get(wave)
        if wfs is None:
            # Locked-table escape only via NEW-WAVE-N dependency line.
            if not re.search(rf"NEW-WAVE-{wave}\b", ln):
                violations.append(f"width: dispatch for wave {wave} not in the locked table: {ln[:110]}")
            continue
        named = all(re.search(rf"\b{wf}\b", ln) for wf in wfs)
        justified = "Width justification" in ln or "full PART 2 scripted width" in ln
        if not named or not justified:
            violations.append(
                f"width: wave {wave} dispatch below scripted width or missing justification: {ln[:110]}")
        # Padding: the dispatch names the locked workflows with their locked
        # seat counts (e.g. '5 Opus builders + 5 Sonnet blind critics each');
        # a count above the locked per-workflow width is padding past the work.
        pad = re.search(r"(\d+)\s+(?:Opus\s+)?builders?\s*[+-]\s*(\d+)\s+(?:Sonnet\s+)?(?:blind\s+)?critics?\s+each", ln)
        if pad:
            builders, critics = int(pad.group(1)), int(pad.group(2))
            per_wf = next(iter(wfs.values())) if wfs else 5
            if builders > per_wf or critics > per_wf:
                violations.append(
                    f"width: wave {wave} dispatch padded past the work "
                    f"({builders}+{critics} > locked {per_wf} per workflow): {ln[:110]}")
    return violations


def check_claims(lines):
