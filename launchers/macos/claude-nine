#!/bin/bash
# `claude-nine` (also `claude-9`) — Claude Code routed through 9Router.
#
# Config lives in its own dir, ~/.claude-nine, so the router's base URL, model
# map and history stay completely separate from the real CLI's ~/.claude. The
# router token is read from the macOS Keychain by the `apiKeyHelper` in
# ~/.claude-nine/settings.json — never stored in plaintext here.
#
# Execs the native binary directly rather than calling `claude`, so it does not
# matter which `claude` is first on PATH.
set -uo pipefail

# Resolve through symlinks: this script is reached via ~/.local/bin/claude-nine
# and ~/bin/claude-9, so dirname on $0 alone points at the wrong directory and
# the library next to the real script would not be found.
_cc_src="${BASH_SOURCE[0]}"
while [ -L "$_cc_src" ]; do
  _cc_target="$(readlink "$_cc_src")"
  case "$_cc_target" in
    /*) _cc_src="$_cc_target" ;;
    *) _cc_src="$(dirname "$_cc_src")/$_cc_target" ;;
  esac
done
SELF_DIR="$(cd "$(dirname "$_cc_src")" && pwd)"
unset _cc_src _cc_target
# shellcheck source=claude-code-lib.sh
. "$SELF_DIR/claude-code-lib.sh"

PORT=20128
# Respect a caller-provided config dir (e.g. claude-kimi's own profile);
# default to claude-nine so behaviour is unchanged for normal launches.
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude-nine}"

# GitHub MCP plugin needs GITHUB_PERSONAL_ACCESS_TOKEN present in the LAUNCH
# environment: its .mcp.json expands ${GITHUB_PERSONAL_ACCESS_TOKEN} into the
# Bearer header at session start. A SessionStart hook runs too late (plugin
# MCP servers spawn before hooks). Token comes from the signed-in gh CLI
# account's keyring. Never printed.
if [ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  GH_TOKEN_FOR_MCP="$(gh auth token 2>/dev/null || true)"
  if [ -n "$GH_TOKEN_FOR_MCP" ]; then
    export GITHUB_PERSONAL_ACCESS_TOKEN="$GH_TOKEN_FOR_MCP"
  else
    echo "⚠️  gh auth token unavailable — github MCP plugin will fail auth." >&2
  fi
  unset GH_TOKEN_FOR_MCP
fi

if [ ! -f "$CLAUDE_CONFIG_DIR/settings.json" ]; then
  echo "claude-nine: missing $CLAUDE_CONFIG_DIR/settings.json — router config is gone." >&2
  echo "  It should set env.ANTHROPIC_BASE_URL to http://127.0.0.1:$PORT/v1 and" >&2
  echo "  apiKeyHelper to ~/.local/bin/get-9router-key.sh" >&2
  exit 1
fi

# Keep the 9Router stream-translator fix applied. An `npm i -g 9router` or a
# 9router self-update silently overwrites it and restores a ~50% tool-call
# corruption rate (doubled tool-argument JSON). This re-applies it if missing.
if [ -x "$HOME/.local/bin/9router-dupfix-guard.sh" ]; then
  "$HOME/.local/bin/9router-dupfix-guard.sh" --quiet || \
    echo "⚠️  9router dup-fix could not be applied — expect tool-call errors." >&2
fi

# Keep the 9Router codex→Claude terminal-event fix applied. Codex is the only
# provider that needs TWO format hops to reach Anthropic wire format
# (openai-responses → openai → claude), and 9router runs both hops on ONE
# shared state object. The dup-fix guard above keys its idempotency on
# `finishReason`, which hop 1 has already set — so hop 2 skipped emitting
# content_block_stop / message_delta / message_stop AND the tool-argument
# flush. Every cx/* model then failed with "API returned an empty or malformed
# response (HTTP 200)". This re-namespaces that flag so both fixes hold.
#
# MUST run AFTER the dup-fix guard: it converts the flag the dup-fix guard
# writes, so on a fresh 9router install the dup-fix patch has to land first.
if [ -x "$HOME/.local/bin/9router-codex-terminal-guard.sh" ]; then
  "$HOME/.local/bin/9router-codex-terminal-guard.sh" --quiet || \
    echo "⚠️  9router codex terminal fix could not be applied — expect cx/* models to return empty responses." >&2
fi

# Keep the 9Router unscoped-kill fix applied. 9router's killAllAppProcesses()
# SIGKILLs every process whose `ps aux` line contains "next-server" — which is
# EVERY Next.js app on the machine, not just its own — on each start, kickstart
# and reboot. An `npm i -g 9router` or a self-update restores that behaviour.
if [ -x "$HOME/.local/bin/9router-nextserver-guard.sh" ]; then
  "$HOME/.local/bin/9router-nextserver-guard.sh" --quiet || \
    echo "⚠️  9router next-server scope fix could not be applied — other Next.js apps may be killed." >&2
fi

# Keep the 9Router cache_control passthrough fix applied. 9router's CLAUDE->OPENAI
# translator strips every `cache_control` breakpoint Claude Code sends, because the
# `preserveCacheControl` quirk is set only on Alibaba's own direct endpoints — not
# on `openai-compatible`, which is how OpenRouter/DeepSeek/Ollama are reached.
# Providers that REQUIRE an explicit breakpoint (Alibaba Qwen, Google Gemini,
# Anthropic via OpenRouter) then cache nothing and bill every token at the
# cache-miss rate, ~31x the cache-hit rate. An `npm i -g 9router` or self-update
# restores the stripping.
if [ -x "$HOME/.local/bin/9router-cachecontrol-guard.sh" ]; then
  "$HOME/.local/bin/9router-cachecontrol-guard.sh" --quiet || \
    echo "⚠️  9router cache_control fix could not be applied — Qwen/Gemini/Anthropic will not cache." >&2
fi

# Keep the 9Router GLM 5.3 / GLM 5.3 Flash thinking-effort fixes applied. The
# stock capability table omits thinkingEffortSupported on the GLM 5.3 Flash
# entry, scopes the low/high/max level rule to CodeBuddy only, and never
# translates reasoning effort into OpenRouter's envelope — so low vs max
# reasoning is flat or inverted through 9router even though it spreads ~10x
# direct to the model. An `npm i -g 9router` or self-update restores all three.
if [ -x "$HOME/.local/bin/9router-glm53-thinking-guard.sh" ]; then
  "$HOME/.local/bin/9router-glm53-thinking-guard.sh" --quiet || \
    echo "⚠️  9router GLM 5.3 thinking fix could not be applied — low/high/max reasoning will not scale." >&2
fi

# Keep the 9Router DeepSeek effort mapping applied. DeepSeek's documented
# efforts are low/high/max; the repaired serializer maps low/minimal to low,
# max/ultra to max, and all other non-none levels to high. A bare npm update
# restores the old collapse of low to high-rewrite and xhigh misrouting.
# This serializer lives in the same bundle as the GLM repair above; the GLM
# guard does not own it, so it is checked separately and refuses quiet success.
# The acceptance script exists only where that repair was applied; elsewhere
# (a stock client install) there is nothing to check, so this is a silent no-op.
_ds_check="$HOME/.9router/verification/glm-acceptance-20260918/final-dispatch.cjs"
if [ -f "$_ds_check" ] && ! node "$_ds_check" >/dev/null 2>&1; then
  echo "⚠️  DeepSeek effort mapping check failed — low/xhigh suffixes may misroute." >&2
fi
unset _ds_check

# Keep the 9Router Ollama streaming terminator fix applied. Native Ollama
# completion arrives as done:true, but the OpenAI translator flush did not emit
# the client SSE [DONE] sentinel. A bare update restores the omitted sentinel.
#
# Anchored ONLY on tokens a minifier cannot rename -- the OLLAMA enum member,
# the finishReason property and the literal sentinel -- and scanned across the
# whole build dir. The previous check hardcoded chunk 8895.js and the minified
# locals `p`/`C`; broadening the fix to also cover ollama-local and the OLLAMA
# enum left that literal substring nowhere on disk, so it warned on every launch
# about a fix that was present and in fact more complete than it expected.
#
# Exit codes are kept distinct on purpose: absent is not the same claim as
# could-not-look, and this must never report the second as the first.
# Only scanned where that patched build lives (~/.npm-global); nine-router-setup
# installs 9Router under its own prefix, so on a client this is a silent no-op.
_ollama_rc=0
[ ! -d "$HOME/.npm-global/lib/node_modules/9router/app/.next-cli-build" ] || node -e '
const fs=require("fs"),path=require("path");
const root=process.env.HOME+"/.npm-global/lib/node_modules/9router/app/.next-cli-build";
const RE=/\.OLLAMA\)&&[A-Za-z_$]+\.finishReason\)\{[^{}]*data: \[DONE\]/;
let ok=false;
function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){if(ok)return;
const q=path.join(d,e.name);
if(e.isDirectory())walk(q);
else if(e.name.endsWith(".js")){let s;try{s=fs.readFileSync(q,"utf8")}catch(_){continue}
if(RE.test(s)){ok=true;return}}}}
try{walk(root)}catch(_){process.exit(2)}
process.exit(ok?0:1);
' >/dev/null 2>&1 || _ollama_rc=$?
case "$_ollama_rc" in
  0) ;;
  1) echo "⚠️  Ollama streaming terminator fix missing — Ollama streams may omit [DONE]." >&2 ;;
  *) echo "⚠️  Ollama streaming terminator fix UNVERIFIED — could not scan $HOME/.npm-global/lib/node_modules/9router/app/.next-cli-build" >&2 ;;
esac
unset _ollama_rc

# Keep the 9Router agnes-3.0-flash capability entry applied. Without it, the
# Agnes AI provider node's agnes-3.0-flash model falls back to
# DEFAULT_CAPABILITIES (reasoning off, no tool-call support signalled). An
# `npm i -g 9router` or self-update wipes this hand-added entry.
if [ -x "$HOME/.local/bin/9router-agnes30-caps-guard.sh" ]; then
  "$HOME/.local/bin/9router-agnes30-caps-guard.sh" --quiet || \
    echo "⚠️  9router agnes-3.0-flash caps fix could not be applied — reasoning/tools will not signal for it." >&2
fi

# Keep the 9Router OpenCode (oc/*) non-streaming fix applied. OpenCode's
# transformRequest always forces stream:true upstream, but its buildHeaders
# advertises Accept:*/* whenever the CLIENT asked for a non-streaming reply, and
# the upstream SSE body then arrives truncated; the shared OPENAI_RESPONSES
# non-stream aggregator turns that truncation into HTTP 200 with
# finish_reason:"in_progress", empty content and zero usage. oc/muse-spark-1.3-
# contributor-free is the first member of opus-chain, so the chain could hand
# back an empty answer silently. An `npm i -g 9router` or self-update reverts it.
if [ -x "$HOME/.local/bin/9router-opencode-poll-guard.sh" ]; then
  "$HOME/.local/bin/9router-opencode-poll-guard.sh" --quiet || \
    echo "⚠️  9router OpenCode non-stream fix could not be applied — oc/* may return empty 200s on long generations." >&2
fi

# claude-nine loads skills from ~/.claude-nine/skills, a different dir from the
# regular CLI's ~/.claude/skills. Without this, any skill added to the regular CLI
# is invisible here. Links in what's missing and prunes links to deleted skills.
# Never blocks the launch — claude-nine still starts if this fails.
if [ -x "$HOME/.local/bin/sync-nine-skills.sh" ]; then
  "$HOME/.local/bin/sync-nine-skills.sh" --quiet || true
fi

# Keep the 9Router model catalog limits correct (DeepSeek V4 Flash is 1M
# context, not the 128K the package ships). An `npm i -g 9router` restores the
# wrong value, so re-apply it every launch (a ~50ms scan). Exit 10 = patched:
# the running router still holds the old catalog, so restart it. The restart
# finds whatever launchd job owns the listener (no hardcoded label); with no
# launchd job it stops the listener and the start block below brings it back.
# Exit 2 (undetermined) never blocks the launch.
_cat_fix=""
for _f in "$SELF_DIR/fix-9router-catalog.mjs" \
          "$SELF_DIR/../../.claude/skills/nine-router-setup/scripts/common/fix-9router-catalog.mjs"; do
  [ -f "$_f" ] && { _cat_fix="$_f"; break; }
done
_cat_rc=0
[ -z "$_cat_fix" ] || node "$_cat_fix" --quiet >/dev/null 2>&1 || _cat_rc=$?
if [ "$_cat_rc" = 10 ] && /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
  echo "🔧 9router catalog corrected — restarting 9router to load it..." >&2
  _lpid="$(/usr/sbin/lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
  if [ -n "$_lpid" ]; then
    _ppid="$(ps -o ppid= -p "$_lpid" 2>/dev/null | tr -d ' ')"
    _label="$(launchctl list 2>/dev/null | awk -v a="$_lpid" -v b="${_ppid:-x}" '$1==a||$1==b{print $3; exit}')"
    if [ -n "$_label" ]; then
      launchctl kickstart -k "gui/$(id -u)/$_label" >/dev/null 2>&1 || true
    else
      kill "$_lpid" 2>/dev/null || true
    fi
    # Wait until the old listener is gone and (launchd case) a new one answers.
    for _ in $(seq 1 40); do
      _now="$(/usr/sbin/lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
      if [ -n "$_label" ]; then [ -n "$_now" ] && [ "$_now" != "$_lpid" ] && break
      else [ "$_now" != "$_lpid" ] && break; fi
      sleep 0.5
    done
  fi
  unset _lpid _ppid _label _now
fi
unset _cat_fix _cat_rc _f

# Start 9router if nothing is listening, rather than just refusing to launch.
if ! /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
  echo "🔌 9router not running on :${PORT} — starting it..." >&2
  mkdir -p "$HOME/.9router"
  nohup 9router --no-browser >"$HOME/.9router/cli-launch.log" 2>&1 &
  for _ in $(seq 1 40); do
    /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 && break
    sleep 0.5
  done
  if ! /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; then
    echo "❌ 9router did not come up on :${PORT}. See ~/.9router/cli-launch.log" >&2
    exit 1
  fi
fi

echo "🚀 Claude Code via 9Router (config: ~/.claude-nine)" >&2

CC_BIN="$(cc_resolve_binary)" || exit 1

# Ultracode opt-in. The binary models ultracode as `xhigh` PLUS a separate
# session-only boolean and exports only the LEVEL to child processes, so
# CLAUDE_EFFORT reads plain "xhigh" and no subprocess can tell ultracode from
# xhigh. Export an explicit marker beside the flag so in-session checks
# (spec-protocol GATE 0 witness 1) can see what was actually requested.
# Opt in with `claude-nine --ultracode ...` or CLAUDE_NINE_ULTRACODE=1.
#
# STICKY (fixes the GATE 0 loop). `/effort ultracode` typed inside a session is
# invisible to every subprocess -- the binary exports only the LEVEL (`xhigh`),
# so a later `claude-nine` could not know ultracode had ever been chosen, and
# spec-protocol GATE 0 told the user to enable what they already had. The choice
# is therefore remembered here, in this launcher's own config root, and re-applied
# on every launch until it is explicitly cleared:
#   claude-nine --ultracode      turn it on, and remember it
#   claude-nine --no-ultracode   turn it off, and forget it
# CLAUDE_NINE_ULTRACODE in the environment always wins over the remembered value.
CC_EFFORT_ARGS=()
CC_ULTRA_STATE="$CLAUDE_CONFIG_DIR/.last-effort"
case "${1:-}" in
  --ultracode)
    shift
    export CLAUDE_NINE_ULTRACODE=1
    printf 'ultracode\n' >"$CC_ULTRA_STATE" 2>/dev/null || true
    ;;
  --no-ultracode)
    shift
    export CLAUDE_NINE_ULTRACODE=0
    rm -f "$CC_ULTRA_STATE" 2>/dev/null || true
    ;;
esac
if [ -z "${CLAUDE_NINE_ULTRACODE:-}" ] \
   && [ -r "$CC_ULTRA_STATE" ] \
   && [ "$(cat "$CC_ULTRA_STATE" 2>/dev/null)" = "ultracode" ]; then
  export CLAUDE_NINE_ULTRACODE=1
fi
if [ "${CLAUDE_NINE_ULTRACODE:-}" = "1" ]; then
  CC_EFFORT_ARGS=(--effort ultracode)
  echo "   effort:         ultracode (xhigh + dynamic workflow orchestration)" >&2
fi

# MODEL PIN. Claude Code loads <cwd>/.claude/settings.json as PROJECT settings,
# which beat user settings. Launching from $HOME therefore picks up plain Claude
# Code's ~/.claude/settings.json (a raw Anthropic model id) and overrides
# this profile's own model, sending a raw Anthropic id to the router where the
# ANTHROPIC_DEFAULT_*_MODEL alias map never fires. A CLI flag beats every
# settings file, so pass this profile's own model explicitly unless the caller
# already gave one. Aliases (fable/opus/sonnet/haiku) still resolve through
# ~/.claude-nine/settings.json env to fable-chain/opus-chain/etc.
CC_MODEL_ARGS=()
cc_has_model_flag=0
for _a in "$@"; do
  case "$_a" in --model|--model=*|-m) cc_has_model_flag=1; break ;; esac
done
if [ "$cc_has_model_flag" = 0 ]; then
  CC_PIN_MODEL="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("model") or "")' "$CLAUDE_CONFIG_DIR/settings.json" 2>/dev/null || true)"
  if [ -n "$CC_PIN_MODEL" ]; then
    CC_MODEL_ARGS=(--model "$CC_PIN_MODEL")
    echo "   model:          $CC_PIN_MODEL (pinned from ~/.claude-nine/settings.json)" >&2
  fi
fi
unset _a cc_has_model_flag

exec "$CC_BIN" ${CC_EFFORT_ARGS[@]+"${CC_EFFORT_ARGS[@]}"} ${CC_MODEL_ARGS[@]+"${CC_MODEL_ARGS[@]}"} "$@"
