#!/usr/bin/env bash
# claude-nine — macOS launcher: start/verify 9Router, load protected routed-session
# state, export routing env vars only into the child process, and exec the same
# Claude Code installation through 9Router.
#
# Never echoes API keys, the router token, or the dashboard password.
set -euo pipefail

PORT="${NINEROUTER_PORT:-20128}"
BASE="http://127.0.0.1:$PORT"
STATE_DIR="$HOME/Library/Application Support/BlackCEO/999"
STATE_FILE="$STATE_DIR/router-session.json"
KEYCHAIN_SERVICE="BlackCEO-999"
KEYCHAIN_ACCOUNT="9router-api-token"
LOG_DIR="$HOME/Library/Logs/BlackCEO-999"
DUPFIX_GUARD="$HOME/.local/bin/9router-dupfix-guard.sh"

port_healthy() {
  curl -fsS -o /dev/null "$BASE/api/health" 2>/dev/null
}

start_router() {
  local launchctl_bin="/bin/launchctl"
  if [ -x "$launchctl_bin" ] && \
     "$launchctl_bin" print "gui/$(id -u)/com.blackceo.9router-localhost" >/dev/null 2>&1; then
    "$launchctl_bin" kickstart -k "gui/$(id -u)/com.blackceo.9router-localhost" >/dev/null 2>&1 || true
  else
    local bin="${NINEROUTER_BINARY:-}"
    if [ -z "$bin" ] || [ ! -x "$bin" ]; then
      bin="$HOME/.local/share/999/npm/bin/9router"
    fi
    if [ ! -x "$bin" ]; then
      bin="$(command -v 9router 2>/dev/null || true)"
    fi
    if [ -z "$bin" ] || [ ! -x "$bin" ]; then
      echo "claude-nine: 9router binary not found. Re-run /nine-router-setup." >&2
      return 1
    fi
    mkdir -p "$LOG_DIR"
    # --host 127.0.0.1 is a security requirement: default binds 0.0.0.0 and
    # exposes the dashboard + /v1 (holding provider keys) to the LAN.
    nohup "$bin" --no-browser --host 127.0.0.1 > "$LOG_DIR/9router.log" 2>&1 &
  fi
  local i
  for i in $(seq 1 40); do
    port_healthy && return 0
    sleep 0.5
  done
  echo "claude-nine: 9Router did not become healthy on $BASE." >&2
  return 1
}

main() {
  # 1. Resolve the same claude binary plain `claude` uses.
  local claude
  claude="$(command -v claude 2>/dev/null || true)"
  if [ -z "$claude" ] && [ -x "$HOME/.local/bin/claude" ]; then
    claude="$HOME/.local/bin/claude"
  fi
  if [ -z "$claude" ] || ! "$claude" --version >/dev/null 2>&1; then
    echo "claude-nine: claude not found on PATH. Install Claude Code first." >&2
    exit 1
  fi

  # 2. Protected state + Keychain token.
  if [ ! -f "$STATE_FILE" ]; then
    echo "claude-nine: routed session state missing: $STATE_FILE. Re-run /nine-router-setup." >&2
    exit 1
  fi
  local token
  token="$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)"
  if [ -z "$token" ]; then
    echo "claude-nine: Keychain token missing (service $KEYCHAIN_SERVICE, account $KEYCHAIN_ACCOUNT). Re-run /nine-router-setup." >&2
    exit 1
  fi

  # 3. Keep the stream-translator dup-fix applied; npm i -g 9router or a
  #    self-update silently reverts it. Never blocks the launch.
  if [ -x "$DUPFIX_GUARD" ]; then
    "$DUPFIX_GUARD" --quiet || \
      echo "claude-nine: 9router dup-fix could not be applied — expect tool-call errors." >&2
  fi

  # 4. Ensure 9Router is up (never a second instance when healthy).
  if ! port_healthy; then
    echo "claude-nine: 9Router not healthy on :$PORT — starting it..." >&2
    start_router || exit 1
  fi

  # 5. Routing env — export only into this process (child inherits it).
  export ANTHROPIC_BASE_URL="http://127.0.0.1:$PORT/v1"
  export ANTHROPIC_AUTH_TOKEN="$token"
  unset token

  # Production-default routes (see references/model-routing.md). The (max) suffix
  # is 9Router's thinking-effort mechanism, parsed per-route. A router-session
  # state file that resolves routes overrides these per-launch (see step 6).
  export ANTHROPIC_DEFAULT_FABLE_MODEL="ds/deepseek-v4-flash(max)"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="ds-max/deepseek-v4-pro(max)"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="ds/deepseek-v4-flash(max)"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="ds-light/deepseek-v4-flash"
  export CLAUDE_CODE_SUBAGENT_MODEL="ds/deepseek-v4-flash(max)"
  # Haiku fallback: Agnes AI when the DS Light lane is down (provider-level).
  export ANTHROPIC_DEFAULT_HAIKU_MODEL_FALLBACK="agnes/agnes-2.5-flash"

  # 6. Parse the state file once into exported vars (single node call, no secrets).
  #    A corrupt/unparseable state file MUST fail loudly — never launch claude
  #    unrouted with no routing vars set (that silently behaves like plain claude
  #    and defeats the activation boundary). Resolved routes override the static
  #    defaults above; unresolvable routes fall back to the static defaults.
  #    Effort level is NOT exported (it would override the in-session /effort
  #    picker); set CLAUDE_NINE_FORCE_EFFORT=<level> to pin it for one launch.
  local exports
  if ! exports="$(node - "$STATE_FILE" <<'NODE'
const fs = require("fs");
let s = fs.readFileSync(process.argv[2], "utf8");
let st;
try { st = JSON.parse(s); } catch { throw new Error("corrupt router-session.json"); }
const r = st.routes || {};
if (!r.fable && !r.opus && !r.sonnet && !r.haiku) {
  throw new Error("router-session.json has no resolved routes");
}
const out = [];
const pairs = [
  ["F", "ANTHROPIC_DEFAULT_FABLE_MODEL", r.fable],
  ["OP", "ANTHROPIC_DEFAULT_OPUS_MODEL", r.opus],
  ["SN", "ANTHROPIC_DEFAULT_SONNET_MODEL", r.sonnet],
  ["HK", "ANTHROPIC_DEFAULT_HAIKU_MODEL", r.haiku],
  ["SUB", "CLAUDE_CODE_SUBAGENT_MODEL", r.subagent],
  ["MO", "CLAUDE_CODE_MAX_OUTPUT_TOKENS", String(st.maxOutputTokens || 32000)],
  ["CON", "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY", String(st.concurrency || 10)],
];
// CLAUDE_CODE_EFFORT_LEVEL is deliberately NOT exported from the state file's
// effortLevel. A forced env export overrides the picker (the 2026-08-11
// ultracode-revert bug). Router thinking hints live in the route suffixes
// ((max)), not here.
// Opt back in per launch with CLAUDE_NINE_FORCE_EFFORT=<level>.
if (process.env.CLAUDE_NINE_FORCE_EFFORT) {
  pairs.push(["EFF", "CLAUDE_CODE_EFFORT_LEVEL", process.env.CLAUDE_NINE_FORCE_EFFORT]);
}
// lastEffortSelection (Issue 1 persistence): the user's last /effort selection
// is re-applied at exec time. ultracode becomes the --effort ultracode CLI
// flag on the exec line (the ONLY mechanism that survives a session boundary
// for ultracode); a persistable level becomes a per-launch env export here.
// CLAUDE_NINE_FORCE_EFFORT wins over lastEffortSelection (checked above).
const last = st.lastEffortSelection;
if (typeof last === "string" && !process.env.CLAUDE_NINE_FORCE_EFFORT) {
  if (last === "ultracode") {
    process.stdout.write("LASTEFFORT=ultracode\n");
  } else if (["low", "medium", "high", "xhigh", "max"].includes(last)) {
    pairs.push(["EFF", "CLAUDE_CODE_EFFORT_LEVEL", last]);
  }
}
for (const [, envName, val] of pairs) {
  if (val) out.push(`export ${envName}=${JSON.stringify(String(val))}`);
}
process.stdout.write(out.join("\n") + "\n");
NODE
)"; then
    echo "claude-nine: could not parse routed session state at $STATE_FILE. Re-run /nine-router-setup." >&2
    exit 1
  fi
  eval "$exports"

  # 6b. lastEffortSelection = ultracode -> --effort ultracode CLI flag on the
  #     exec line (session-only by product design; the flag is the only way to
  #     re-enter it across a session boundary).
  EFFORT_ARGS=()
  if [ "$LASTEFFORT" = "ultracode" ]; then
    EFFORT_ARGS=(--effort ultracode)
  fi

  # 7. Assert the routing boundary is actually armed before exec — never launch
  #    claude unrouted. If a required var is missing, the state is corrupt.
  : "${ANTHROPIC_DEFAULT_FABLE_MODEL:?routed session state is corrupt; re-run /nine-router-setup}"
  : "${ANTHROPIC_DEFAULT_OPUS_MODEL:?routed session state is corrupt; re-run /nine-router-setup}"
  : "${ANTHROPIC_DEFAULT_SONNET_MODEL:?routed session state is corrupt; re-run /nine-router-setup}"
  : "${ANTHROPIC_DEFAULT_HAIKU_MODEL:?routed session state is corrupt; re-run /nine-router-setup}"

  # 8. Banner: show which models are wired (model ids only — never tokens).
  echo "🚀 claude-nine via 9Router (http://127.0.0.1:$PORT/v1)" >&2
  echo "   fable/subagent: $ANTHROPIC_DEFAULT_FABLE_MODEL" >&2
  echo "   opus:           $ANTHROPIC_DEFAULT_OPUS_MODEL" >&2
  echo "   sonnet:         $ANTHROPIC_DEFAULT_SONNET_MODEL" >&2
  echo "   haiku:          $ANTHROPIC_DEFAULT_HAIKU_MODEL" >&2
  echo "   haiku fallback: ${ANTHROPIC_DEFAULT_HAIKU_MODEL_FALLBACK:-none}" >&2

  # 9. Exec the same claude binary, forwarding all args. The ultracode flag
  #    (when lastEffortSelection says so) rides first; a user-passed --effort
  #    still wins (claude's CLI takes the last flag).
  exec "$claude" "${EFFORT_ARGS[@]}" "$@"
}

main "$@"
